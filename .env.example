# Node 24.15+; exported variables are consumed by the server.
# For a local HTTP production smoke test ONLY, COOKIE_SECURE=false.
# Keep true behind HTTPS in real deployments.
PORT=3001
HOST=127.0.0.1
DATA_DIR=data
DATABASE_PATH=data/spotfy.sqlite
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=true
# SMTP is optional in development (private data/outbox .eml).
# Required for real password recovery email delivery in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Spotfy <noreply@example.com>
# ADMIN_EMAIL and ADMIN_PASSWORD are only read by npm run admin:create.
# Set them in your secure shell/environment; do not commit their values.
